.container {
  max-width: 680px;
  width: 100%;
  margin: 0 auto;
  padding: 48px 12px 20px;
  box-sizing: border-box;
}

.header { margin-bottom: 8px; }
.header-title { display: flex; align-items: center; justify-content: center; }
.mode-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 10px;
}
.title-accent {
  background: linear-gradient(135deg,#22C55E,#16A34A);
  color: #fff;
  padding: 0 10px;
  border-radius: 4px;
  font-size: 20px;
  font-weight: 700;
}
.title-normal {
  font-size: 20px;
  font-weight: 700;
  color: #E8ECF4;
  margin-left: 4px;
}

.mode-switch {
  display: flex;
  background: #141829;
  border-radius: 8px;
  overflow: hidden;
  padding: 2px;
  border: 1.5px solid #2A3050;
}
.mode-btn {
  padding: 4px 14px;
  font-size: 13px;
  border-radius: 6px;
  transition: all 0.15s ease;
  color: #5A6280;
  font-weight: 600;
}
.mode-btn.active {
  background: #E8ECF4;
  color: #141829;
}

.selected-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  margin-bottom: 10px;
  min-height: 24px;
  font-size: 12px;
  color: #5A6280;
}
.bar-placeholder { font-size: 12px; color: #5A6280; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: #1A2A44;
  color: #E8ECF4;
  font-weight: 600;
  padding: 1px 8px 1px 6px;
  border-radius: 8px;
  font-size: 12px;
  border: 1.5px solid #2A3050;
}
.chip-icon { width: 16px; height: 16px; }

.type-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 4px;
  margin-bottom: 14px;
}
.type-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  padding: 5px 3px;
  background: #1C2138;
  border: 1.5px solid #2A3050;
  border-radius: 8px;
  transition: all 0.15s ease;
}
.type-btn:active { opacity: 0.8; }
.type-btn.selected {
  background: #22C55E;
  border-color: #22C55E;
}
.type-btn.selected .type-icon { transform: scale(1.08); }
.type-btn.selected .type-label { color: #fff; }
.type-icon { width: 24px; height: 24px; transition: transform 0.15s ease; }
.type-label { font-size: 10px; color: #B8BED0; font-weight: 700; }

.chart-area {
  background: #141829;
  border: 1.5px solid #2A3050;
  border-radius: 12px;
  padding: 12px 12px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.chart-canvas { display: block; }

.legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 8px;
  font-size: 12px;
  font-weight: 600;
}
.dot {
  display: inline-block;
  width: 10px; height: 10px;
  border-radius: 50%;
  margin-right: 3px;
  vertical-align: middle;
}
.dot.green { background: #22C55E; }
.dot.red { background: #EF4444; }
.dot.gray { background: #7A7A9A; }
.l-green { color: #4ADE80; }
.l-red { color: #F87171; }
.l-gray { color: #9098B0; }

.empty-state {
  text-align: center;
  padding: 50px 20px;
  color: #484E70;
  font-size: 16px;
  line-height: 1.8;
}
.empty-accent { color: #22C55E; }
